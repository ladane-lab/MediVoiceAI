# ============================================
# MediVoice AI - Environment Configuration
# Copy this file to .env (and/or frontend/.env.local & backend/.env)
# Never commit real API keys to version control.
# ============================================

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./medivoice.db

# --- AI & Voice Services (Used in Phase 4+) ---
# Google Gemini LLM API Key & Model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ElevenLabs STT & TTS API Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# WebRTC STUN/TURN servers (comma-separated)
VOICE_ICE_SERVERS=stun:stun.l.google.com:19302

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=MediVoice AI
